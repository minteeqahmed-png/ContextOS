# Copy to .env for local settings. Existing process environment takes precedence.
CONTEXTOS_MODE=LOCAL_ONLY
CONTEXTOS_REVIEW_POLICY=interactive
CONTEXTOS_OLLAMA_BASE_URL=http://127.0.0.1:11434
CONTEXTOS_LOCAL_VISION_MODEL=llama3.2-vision
CONTEXTOS_EMBED_MODEL=nomic-embed-text
CONTEXTOS_VISION_PROVIDER=openrouter
CONTEXTOS_VISION_BASE_URL=https://openrouter.ai/api/v1
CONTEXTOS_VISION_MODEL=meta-llama/llama-4-maverick
# Explicit recipient: current OpenRouter model endpoint catalog lists digitalocean.
# Review its policies and availability before opting in. No provider fallbacks.
CONTEXTOS_OPENROUTER_PROVIDER=digitalocean
OPENROUTER_API_KEY=
# Generic OpenAI-compatible endpoints use CONTEXTOS_VISION_API_KEY instead.
CONTEXTOS_VISION_API_KEY=
# Gemini demo: python start_gemini.py (sets provider/model and interactive review).
CONTEXTOS_OCR_TIMEOUT_SECONDS=90
